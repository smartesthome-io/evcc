[Unit]
Description=Back up the evcc database
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=evcc
Group=evcc
UMask=0077
StateDirectory=evcc-backup
Environment=BACKUP_DIR=/var/lib/evcc-backup
Environment=KEEP=14
# database settings of evcc, alternatively use /etc/evcc.yaml
Environment=EVCC_DATABASE_DSN=postgres://evcc:password@localhost:5432/evcc
ExecStart=/usr/local/bin/evcc-backup.sh
